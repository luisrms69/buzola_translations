# Configuración de Claude Code — no versionar. Los comandos son un symlink a
# frappe-infrastructure/.claude/commands recreado por el scaffold; su destino es una ruta
# absoluta específica de la máquina, por eso NO se versiona (patrón de erpnext_proposals).
.claude/

# Scripts temporales / one-offs privados — nunca se versionan.
one_offs/

# Respaldos locales y temporales de auditoría de traducción — no versionar.
*.backup-*.json
*.tmp.csv

# Artefactos de extracción (POT fresco + manifiesto) — reproducibles, no versionar.
.artifacts/
