msgid ""
"<h4>Condition Examples</h4>\n"
"<ol>\n"
"<li>Applying tax if employee born between 31-12-1937 and 01-01-1958 (Employees aged 60 to 80)<br>"
"\n"
"<code>Condition: date_of_birth&gt;date(1937, 12, 31) and date_of_birth&lt;date(1958, 01, "
"01)</code></li><br><li>Applying tax by employee gender<br>\n"
"<code>Condition: gender==\"Male\"</code></li><br>\n"
"<li>Applying tax by Salary Component<br>\n"
"<code>Condition: base &gt; 10000</code></li></ol>"
msgstr ""
"<h4>Ejemplos de Condiciones</h4>\n"
"<ol>\n"
"<li>Aplicar impuesto si el empleado nació entre el 31-12-1937 y el 01-01-1958 (empleados de 60 a "
"80 años)<br>\n"
"<code>Condition: date_of_birth&gt;date(1937, 12, 31) and date_of_birth&lt;date(1958, 01, "
"01)</code></li><br><li>Aplicar impuesto por género del empleado<br>\n"
"<code>Condition: gender==\"Male\"</code></li><br>\n"
"<li>Aplicar impuesto por Concepto de Nómina<br>\n"
"<code>Condition: base &gt; 10000</code></li></ol>"

